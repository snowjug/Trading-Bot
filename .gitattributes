reports/charts/*.html linguist-detectable=false
reports/charts/*.html linguist-generated=true
*.html linguist-detectable=false
*.html linguist-generated=true

# Mark data and logs as generated/non-detectable
data/** linguist-detectable=false
data/** linguist-generated=true
experiments/** linguist-detectable=false
experiments/** linguist-generated=true
reports/*.json linguist-detectable=false
reports/*.csv linguist-detectable=false
