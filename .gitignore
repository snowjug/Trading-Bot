# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Credentials - NEVER commit
.env
*.pem
*.key
credentials/

# Data files (too large for git)
data/raw/**/*.parquet
data/raw/**/*.csv
data/processed/**/*.parquet
data/features/**/*.parquet
data/news/**/*.json
data/events/**/*.json
*.h5
*.hdf5

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
!data/news/.gitkeep
!data/events/.gitkeep

# Database
*.db
*.duckdb
*.sqlite

# Logs
logs/*.log
logs/**/*.log

# Model checkpoints (large)
models/checkpoints/**/*.pkl
models/checkpoints/**/*.joblib
models/checkpoints/**/*.pt

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
docker-data/

# State files
state/*.json
state/*.pkl

# Scratch scripts
scratch/

# Scrip master cache
data/dhan_scrip_master_*.csv
data/raw/**/.consolidated_*.parquet
data/paper_session/
data/paper/
tmp/

# Large REBUILDABLE research caches (one command each, see reports/ACTIVE_RESEARCH_STATE.md):
#   grid5m_{ce,pe}     -> stitched from data/raw/dhan/option_grid_5m, ~95MB
#   equity_panel       -> src/research/equity_panel.py, ~53MB
#   overnight_raw/put  -> intermediate probes, superseded by src/research/overnight.py
# chain_panel.parquet is kept: it is 1.1MB and several tests key off it.
data/derived/grid5m_*.parquet
data/derived/equity_panel.parquet
data/derived/overnight_raw.parquet
data/derived/overnight_put.parquet
data/derived/futstk_*.parquet
data/derived/bn_*.parquet

# Raw NSE F&O bhavcopy zips — byte-for-byte provenance cache, re-downloadable from
# nsearchives.nseindia.com; sha256 of every file is recorded in
# data/catalog/fo_full_ingest_ledger.csv so any row can be verified without them.
data/raw/nse/fo_zip/
# Per-session parquet extracted from those zips (futures + all index options).
data/raw/nse/fo_futures/
data/raw/nse/fo_idxopt/
# Official Dhan scrip master snapshot (25MB, re-downloadable; provenance in
# data/catalog/scrip_master_provenance.json)
data/raw/dhan/scrip_master/
