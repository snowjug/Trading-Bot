# ================================================================
# Indian Quant Research Agent - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ================================================================

# SAFETY GATE - MUST ALWAYS BE false
LIVE_TRADING_ENABLED=false

# ================================================================
# BROKER APIs (fill only the ones you use)
# ================================================================

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Angel One SmartAPI
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# FYERS
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_ACCESS_TOKEN=

# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ================================================================
# DATA PROVIDERS
# ================================================================

# No API key needed for yfinance (default provider)

# ================================================================
# DATABASE
# ================================================================
DUCKDB_PATH=data/research.duckdb

# ================================================================
# RESEARCH SETTINGS
# ================================================================
DEFAULT_UNIVERSE=NIFTY50
DEFAULT_TIMEFRAME=daily
INITIAL_CAPITAL=1000000
MAX_POSITION_PCT=0.10
MAX_SECTOR_PCT=0.30
MAX_PORTFOLIO_DRAWDOWN=0.15
DAILY_LOSS_LIMIT=0.03
WEEKLY_LOSS_LIMIT=0.05

# ================================================================
# MONITORING
# ================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ================================================================
# EXPERIMENT TRACKING
# ================================================================
EXPERIMENT_DIR=experiments

# ================================================================
# PAPER TRADING
# ================================================================
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_CAPITAL=1000000
