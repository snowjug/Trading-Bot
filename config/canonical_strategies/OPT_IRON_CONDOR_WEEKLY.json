        "role": "long_put",
        "strike": "ATM_MINUS_350",
        "side": "BUY"
      },
      {
        "role": "short_put",
        "strike": "ATM_MINUS_150",
        "side": "SELL"
      },
      {
        "role": "short_call",
        "strike": "ATM_PLUS_150",
        "side": "SELL"
      },
      {
        "role": "long_call",
        "strike": "ATM_PLUS_350",
        "side": "BUY"
      }
    ]
  },
  "stop_rules": {
    "type": "WING_WIDTH_BOUNDED"
  },
  "exit_rules": {
    "type": "EXPIRY_SETTLEMENT"
  },
  "target_rules": {
    "type": "FULL_NET_CREDIT"
  },
  "position_sizing": {
    "unit": "LOTS",
    "lots": 1,
    "max_risk_pct_account": 0.6
  },
  "capital_requirement": {
    "rule": "DEFINED_MAX_LOSS",
    "minimum_account": 25000.0
  },
  "execution_assumptions": {
    "order_type": "MARKET_OR_LIMIT_AT_CLOSE",
    "slippage_model": "HALF_SPREAD_PLUS_TICKS",
    "cost_model": "INDIAN_STATUTORY_POST_OCT_2024"
  }
